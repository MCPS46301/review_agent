# ============================================================
#  Macomb Powersports — Review Auto-Responder Configuration
#  Copy this file to .env and fill in your credentials.
# ============================================================

# ── Business Settings ────────────────────────────────────────
BUSINESS_NAME="Macomb Powersports"
BUSINESS_OWNER_EMAIL="your-email@example.com"
BUSINESS_OWNER_NAME="Your Name"
# Set this to your Vercel deployment URL in production:
# e.g. "https://macomb-reviews.vercel.app"
APP_BASE_URL="http://localhost:8000"

# How often to check for new reviews (minutes — local dev only)
# On Vercel this is controlled by vercel.json crons schedule
POLL_INTERVAL_MINUTES=15

# ── Database ─────────────────────────────────────────────────
# Local dev: leave as SQLite (default, no setup needed)
# Production (Supabase): paste the connection string from
#   Supabase Dashboard → Project Settings → Database
#   → Connection string → URI tab
#   Use the "Session mode" pooler (port 5432) for Vercel serverless:
#   postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL="sqlite:///./reviews.db"

# ── Claude AI (Required) ─────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-api03-..."

# ── Email Notifications (Required for alerts) ────────────────
# Gmail example: enable "App Passwords" at myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail@gmail.com"
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"   # App Password (not your regular password)
SMTP_FROM_EMAIL="your-gmail@gmail.com"
SMTP_USE_TLS=true

# ── Google Business Profile API ──────────────────────────────
# Setup: https://developers.google.com/my-business/content/prereqs
# 1. Go to console.cloud.google.com → Create project
# 2. Enable "Business Profile API"
# 3. Create OAuth 2.0 credentials (Desktop App)
# 4. Run the OAuth flow to get GOOGLE_REFRESH_TOKEN
# 5. Find your location name:
#    GET https://mybusinessaccountmanagement.googleapis.com/v1/accounts
#    Then: GET https://mybusinessbusinessinformation.googleapis.com/v1/{account}/locations
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_LOCATION_NAME=""    # e.g. "accounts/1234567890/locations/9876543210"

# ── Facebook Graph API ───────────────────────────────────────
# Setup: https://developers.facebook.com
# 1. Create a Facebook App → Add "Pages" product
# 2. Request permissions: pages_read_engagement, pages_manage_posts,
#    pages_read_user_content
# 3. Generate a long-lived Page Access Token
# 4. Your Page ID is in the About section of your Facebook Page
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""        # Numeric ID or username of your Facebook page

# ── Yelp Fusion API (Read-Only) ──────────────────────────────
# NOTE: Yelp does NOT allow posting responses via API.
#       This app will notify you of new Yelp reviews and generate draft
#       responses, but you must post them manually at biz.yelp.com.
# Setup: https://www.yelp.com/developers/v3/manage_app
# Your business ID is the URL slug on Yelp, e.g.:
#   https://www.yelp.com/biz/macomb-powersports-macomb
#                              ↑ this part is your YELP_BUSINESS_ID
YELP_API_KEY=""
YELP_BUSINESS_ID=""        # e.g. "macomb-powersports-macomb"

# ── Security ─────────────────────────────────────────────────
# Change this to a long random string in production
APP_SECRET_KEY="change-this-to-a-long-random-secret-in-production"

# ── Vercel Cron Protection (Recommended) ─────────────────────
# Set this in Vercel Dashboard → Project → Settings → Environment Variables
# Vercel will send "Authorization: Bearer <CRON_SECRET>" with each cron request.
# Generate one at: openssl rand -hex 32
CRON_SECRET=""
